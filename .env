# ============================================
# antares-bridge — Configuración
# ============================================

# MySQL (datosipspymr) - Base de datos de producción
ANTARES_SERVER=host.docker.internal
ANTARES_PORT=3307
ANTARES_DATABASE=datosipspymr
ANTARES_USER=root
ANTARES_PASSWORD=AntaresDB_2024!

# Service 2 (agenda-system) — URL y API Key
AGENDA_SYSTEM_URL=http://agenda-system-api-1:8000
SYNC_API_KEY=changeme_sync_api_key

# Sync (en segundos)
SYNC_INTERVAL_SECONDS=300
SYNC_LOOKBACK_HOURS=24

# Logging
LOG_LEVEL=INFO
