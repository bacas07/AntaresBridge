# ============================================
# antares-bridge — Configuración
# ============================================

# SQL Server (PastorYMaria) - Base de datos de producción
ANTARES_SERVER=localhost
ANTARES_PORT=1433
ANTARES_DATABASE=PastorYMaria
ANTARES_USER=agenda
ANTARES_PASSWORD=colombial0$

# Service 2 (agenda-system) — URL y API Key
AGENDA_SYSTEM_URL=http://agenda-system-api-1:8000
SYNC_API_KEY=changeme_sync_api_key

# Sync (en segundos)
SYNC_INTERVAL_SECONDS=300
SYNC_LOOKBACK_HOURS=24

# Logging
LOG_LEVEL=INFO
