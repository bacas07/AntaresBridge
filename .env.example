# ============================================
# antares-bridge — Configuración
# ============================================

# MySQL 8.0 (Antares) - Base de datos de producción
ANTARES_SERVER=127.0.0.1
ANTARES_PORT=3306
ANTARES_DATABASE=datosipspymr
ANTARES_USER=cambiar_usuario
ANTARES_PASSWORD="cambiar_password"

# Service 2 (agenda-system) — URL y API Key
AGENDA_SYSTEM_URL=http://localhost:8000
SYNC_API_KEY=changeme_sync_api_key

# Sync (en segundos)
SYNC_INTERVAL_SECONDS=300
SYNC_LOOKBACK_HOURS=24

# Logging
LOG_LEVEL=INFO
